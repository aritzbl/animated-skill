# Copiá este archivo como ".env" y completá los valores. El ".env" NO se comparte, no se sube ni se pega en el chat:
# tts-eleven/generar.mjs lo lee solo y nunca imprime los valores.
ELEVENLABS_API_KEY=
# Voz de Gonza (las líneas sin "voz" en tts-eleven/lineas-dia-0N.json)
ELEVENLABS_VOICE_ID=
# Voz de la mamá (las líneas con "voz": "mama")
ELEVENLABS_VOICE_ID_MAMA=
